<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mirs260x">
	<!-- Define robot constants -->
	<xacro:property name="base_length" value="0.379"/>
	<xacro:property name="base_width" value="0.545"/>
	<xacro:property name="base_height" value="0.178"/>

	<xacro:property name="wheel_radius" value="0.0665"/>
	<xacro:property name="wheel_width" value="0.08"/>
	<xacro:property name="wheel_zgap" value="0.02"/>

	<xacro:property name="laser_zoff" value="0.06"/>
	<xacro:property name="laser_height" value="0.051"/>
	<xacro:property name="laser_radius" value="0.0278"/>

	<xacro:property name="caster_radius" value="0.0665"/>

	<material name="black">
		<color rgba="0 0 0 1"/>
	</material>
	<material name="white">
		<color rgba="1 1 1 1"/>
	</material>
	<material name="red">
		<color rgba="1 0 0 1"/> 
	</material>

	<!--==============================================================
		base_footprint: MIRSの前後左右の回転を無視したときの位置（地面）
	==============================================================-->
	<link name="base_footprint"/>

	<!--==============================================================
		base_link: MIRS本体（コンテナ）
	==============================================================-->
	<link name="base_link">
		<visual>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
			<material name="white"/> 
			<origin xyz="0 0 0"/> 
		</visual>
		<collision>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="15"/>
			<inertia ixx="0.586" ixy="0" ixz="0" iyy="0.313" iyz="0" izz="0.786"/>
		</inertial>
	</link>

	<joint name="base_joint" type="fixed">
		<parent link="base_footprint"/>
		<child link="base_link"/>
		<origin xyz="0 0 ${((wheel_radius*2)+wheel_zgap+(base_height/2))}" rpy="0 0 0"/>
	</joint>

	<!--==============================================================
		wheel：車輪
		origin の rpy でホイールの回転軸が Y軸方向になるように合わせている。
		xacroのmacroで左と右の処理を同時に行っている
		8輪あるよ
	==============================================================-->
	<xacro:macro name="wheel" params="prefix y_reflect x_position">
		<link name="${prefix}_wheel">
			<visual>
				<geometry>
					<cylinder length="${wheel_width}" radius="${wheel_radius}"/>
				</geometry>
				<material name="black"/>
				<origin rpy="${pi/2} 0 0"/>
			</visual>
			<collision>
				<geometry>
					<cylinder length="${wheel_width}" radius="${wheel_radius}"/>
				</geometry>
				<origin rpy="${pi/2} 0 0"/>
			</collision>
			<inertial>
				<mass value="1.425"/>
				<inertia ixx="0.00233" ixy="0" ixz="0" iyy="0.00315" iyz="0" izz="0.00233"/>
			</inertial>
		</link>
		<joint name="${prefix}_wheel_joint" type="continuous">
			<parent link="base_link"/>
			<child link="${prefix}_wheel"/>
			<origin xyz="${x_position} ${y_reflect*(base_width/2-wheel_width/2)} ${-(wheel_radius+wheel_zgap+(base_height/2))}"/>
			<axis xyz="0 1 0"/> 
		</joint>
	</xacro:macro>

	<xacro:wheel prefix="left_1" y_reflect="1" x_position="0.21"/>
	<xacro:wheel prefix="left_2" y_reflect="1" x_position="0.07"/>
	<xacro:wheel prefix="left_3" y_reflect="1" x_position="-0.07"/>
	<xacro:wheel prefix="left_4" y_reflect="1" x_position="-0.21"/>
	<xacro:wheel prefix="right_1" y_reflect="-1" x_position="0.21"/>
	<xacro:wheel prefix="right_2" y_reflect="-1" x_position="0.07"/>
	<xacro:wheel prefix="right_3" y_reflect="-1" x_position="-0.07"/>
	<xacro:wheel prefix="right_4" y_reflect="-1" x_position="-0.21"/>

	<!--==============================================================
		laser：LIDAR のフレーム
	==============================================================-->
	<link name="laser">
		<visual>
			<geometry>
				<cylinder length="${laser_height}" radius="${laser_radius}"/>
			</geometry>
			<material name="red"/>
		</visual>
		<collision>
			<geometry>
				<cylinder length="${laser_height}" radius="${laser_radius}"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="0.1"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
		</inertial>
	</link>
	<joint name="laser_joint" type="fixed">
		<parent link="base_link"/>
		<child link="laser"/>
		<origin xyz="0 0 ${laser_zoff+base_height/2+laser_height/2}" rpy="0 0 0"/> 
	</joint>


	<!--==============================================================
		camera_link：RealSense D435本体（筐体）
		D435 dimensions: 90mm x 25mm x 25mm
	==============================================================-->
	<link name="camera_link">
		<visual>
			<geometry>
				<box size="0.09 0.025 0.025"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<geometry>
				<box size="0.09 0.025 0.025"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="0.072"/>
			<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
		</inertial>
	</link>
	<joint name="camera_joint" type="fixed">
		<parent link="base_link"/>
		<child link="camera_link"/>
		<!-- ロボット前面中央、やや高め -->
		<origin xyz="0.19 0 0.10" rpy="0 0 0"/>
	</joint>

	<!--==============================================================
		camera_color_frame：RGBカメラフレーム
		D435ではカメラ中央より左側(+Y方向)15mm
	==============================================================-->
	<link name="camera_color_frame">
		<inertial>
			<mass value="0.001"/>
			<inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
		</inertial>
	</link>
	<joint name="camera_color_joint" type="fixed">
		<parent link="camera_link"/>
		<child link="camera_color_frame"/>
		<origin xyz="0 0.015 0" rpy="0 0 0"/>
	</joint>

	<!--==============================================================
		camera_color_optical_frame：RGBカメラ光学フレーム（REP-103準拠）
	==============================================================-->
	<link name="camera_color_optical_frame"/>
	<joint name="camera_color_optical_joint" type="fixed">
		<parent link="camera_color_frame"/>
		<child link="camera_color_optical_frame"/>
		<origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
	</joint>

	<!--==============================================================
		camera_depth_frame：Depthカメラフレーム
		D435ではカメラ中央より右側(-Y方向)15mm
	==============================================================-->
	<link name="camera_depth_frame">
		<inertial>
			<mass value="0.001"/>
			<inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
		</inertial>
	</link>
	<joint name="camera_depth_joint" type="fixed">
		<parent link="camera_link"/>
		<child link="camera_depth_frame"/>
		<origin xyz="0 -0.015 0" rpy="0 0 0"/>
	</joint>

	<!--==============================================================
		camera_depth_optical_frame：Depthカメラ光学フレーム（REP-103準拠）
	==============================================================-->
	<link name="camera_depth_optical_frame"/>
	<joint name="camera_depth_optical_joint" type="fixed">
		<parent link="camera_depth_frame"/>
		<child link="camera_depth_optical_frame"/>
		<origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
	</joint>
</robot>
